# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role: SÓ no servidor (Vercel → Environment Variables). Nunca
# prefixe com NEXT_PUBLIC_. Usada só nas rotas do servidor: criar agendamento e ler a ocupação da agenda.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para guardar o IP do visitante como hash (limite de abuso).
# Gere com: openssl rand -hex 32
IP_HASH_SECRET=

# Cloudflare Turnstile (captcha) → dash.cloudflare.com → Turnstile.
# Obrigatório em produção (as duas juntas — o build falha se só uma existir); em desenvolvimento pode ficar vazio.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcional: domínios aceitos no token do captcha, separados por vírgula
# (padrão: o domínio da própria requisição). Ex.: clinicadna.com.br,clinica-dna.vercel.app
TURNSTILE_HOSTNAMES=
